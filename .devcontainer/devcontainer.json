// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
	"name": "storypop-apiplatform",
	"service": "storypop-apiplatform",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	//"image": "mcr.microsoft.com/devcontainers/dotnet:2-9.0",
	"dockerComposeFile": "../../docker-storypop/docker-compose.yml",
	// 2. Specify the path inside the container where the code is mounted
	"workspaceFolder": "/workspaces/storypop-apiplatform",
	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
 		// 1.  installs curl/wget for the other features
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": true,
			"upgradePackages": false
		}
/* 		// 2. Then .NET 
		"ghcr.io/devcontainers/features/dotnet:2": {
			"version": "9.0"
		}  */
	},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [
		7036,
		5000
	],
	"portsAttributes": {
		"7036": {
			"protocol": "https",
			"elevateIfNeeded": true
		},
		"5000": {
			"protocol": "http"
		}
	},
	"customizations": {
		"vscode": {
			"settings": {
				"git.enabled": false,
				"git.autofetch": false,
				 "extensions.verifySignature": false
			}
		}
	},
	"mounts": [
		"source=vscode-server-bin,target=/root/.vscode-server/bin,type=volume"
	],
	// ADD THESE TWO LINES:
	"overrideCommand": true,
	"containerEnv": {
		"VSCODE_AGENT_FOLDER": "/root/.vscode-server"
	}
	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "dotnet restore",
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}